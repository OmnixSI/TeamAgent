{
  "name": "@omnixsi/team-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit --target ES2023 --module ESNext --moduleResolution bundler --lib ES2023,WebWorker src/*.ts --resolveJsonModule",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "test:runner": "python3 -m unittest discover -s test -p '*_test.py' && node --test runner/test_fetcher.mjs runner/test_asr.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:web": "node scripts/build-ui.mjs",
    "precheck": "node scripts/check-config.mjs && node scripts/build-ui.mjs",
    "pretest": "node scripts/check-config.mjs && node scripts/build-ui.mjs",
    "postinstall": "node scripts/check-config.mjs && node scripts/build-ui.mjs",
    "config:check": "node scripts/check-config.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.159.0"
  }
}
