{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "deepseek-flash",
            "deepseek-v4-pro"
          ]
        },
        "quick_effort": {
          "enum": [
            "none",
            "low",
            "high",
            "max"
          ]
        },
        "important_effort": {
          "enum": [
            "none",
            "low",
            "high",
            "max"
          ]
        },
        "effort_by_kind": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "none",
              "low",
              "high",
              "max"
            ]
          }
        },
        "timeouts_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 540000
          }
        }
      },
      "required": [
        "name",
        "quick_effort",
        "important_effort",
        "effort_by_kind",
        "timeouts_ms"
      ]
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string"
        },
        "start_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "end_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "quiet_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "batches_per_night": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "messages_per_batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "timezone",
        "start_hour",
        "end_hour",
        "quiet_minutes",
        "batches_per_night",
        "messages_per_batch"
      ]
    },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          }
        }
      },
      "required": [
        "enabled",
        "hours"
      ]
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jina": {
          "type": "boolean"
        }
      },
      "required": [
        "jina"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repair_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "code_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        },
        "quick_file_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        },
        "heavy_file_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        }
      },
      "required": [
        "repair_rounds",
        "code_timeout_seconds",
        "quick_file_timeout_seconds",
        "heavy_file_timeout_seconds"
      ]
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OmnixSI/[A-Za-z0-9_.-]+$"
      }
    },
    "project_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "daily_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "turn_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "turn_deadline_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled",
        "daily_cap",
        "turn_max",
        "turn_deadline_ms",
        "prompt"
      ]
    },
    "bili": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "wait_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      },
      "required": [
        "enabled",
        "wait_seconds"
      ]
    }
  },
  "required": [
    "model",
    "memory",
    "scout",
    "execution",
    "repositories",
    "project_aliases",
    "bili"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamAgent共享参数"
}
