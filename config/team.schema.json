{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mcp_servers": {
      "type": "array", "maxItems": 8, "default": [],
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
          "enabled": {"type": "boolean", "default": false},
          "transport": {"const": "streamable-http"},
          "url": {"type": "string", "format": "uri", "maxLength": 2048},
          "allow_tools": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"}},
          "group_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 15000, "default": 15000}
        },
        "required": ["name", "enabled", "transport", "url", "allow_tools", "group_ids"]
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "deepseek-flash",
            "deepseek-v4-pro"
          ]
        },
        "quick_effort": {
          "enum": [
            "none",
            "low",
            "high",
            "max"
          ]
        },
        "important_effort": {
          "enum": [
            "none",
            "low",
            "high",
            "max"
          ]
        },
        "effort_by_kind": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "none",
              "low",
              "high",
              "max"
            ]
          }
        },
        "timeouts_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 540000
          }
        }
      },
      "required": [
        "name",
        "quick_effort",
        "important_effort",
        "effort_by_kind",
        "timeouts_ms"
      ]
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string"
        },
        "start_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "end_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "quiet_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "batches_per_night": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "messages_per_batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "timezone",
        "start_hour",
        "end_hour",
        "quiet_minutes",
        "batches_per_night",
        "messages_per_batch"
      ]
    },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          }
        }
      },
      "required": [
        "enabled",
        "hours"
      ]
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jina": {
          "type": "boolean"
        }
      },
      "required": [
        "jina"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repair_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "code_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        },
        "quick_file_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        },
        "heavy_file_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 7200
        }
      },
      "required": [
        "repair_rounds",
        "code_timeout_seconds",
        "quick_file_timeout_seconds",
        "heavy_file_timeout_seconds"
      ]
    },
    "schedules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_active_per_group": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_sends_per_group_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_sends_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "report_window": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      },
      "required": [
        "max_active_per_group",
        "max_sends_per_group_day",
        "max_sends_day",
        "report_window"
      ]
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OmnixSI/[A-Za-z0-9_.-]+$"
      }
    },
    "project_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "daily_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "turn_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "turn_deadline_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled",
        "daily_cap",
        "turn_max",
        "turn_deadline_ms",
        "prompt"
      ]
    },
    "bili": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "wait_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rtf": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "deadline_cap_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mem_cap_mb": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tmp_cap_mb": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "enabled",
            "max_minutes",
            "rtf",
            "deadline_cap_minutes",
            "mem_cap_mb",
            "tmp_cap_mb"
          ]
        }
      },
      "required": [
        "enabled",
        "wait_seconds",
        "media"
      ]
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mention",
        "image",
        "busy",
        "idle",
        "cap_ms",
        "wait_min",
        "wait_max",
        "wait_horizon_ms",
        "hard_window_ms",
        "hard_humans"
      ],
      "properties": {
        "mention": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "image": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "busy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "idle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "cap_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "wait_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 45
        },
        "wait_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 45
        },
        "wait_horizon_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "hard_window_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "hard_humans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "feature_requests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auto_senders": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "daily_auto_cap": {
          "type": "integer",
          "minimum": 1
        },
        "daily_cap_per_sender": {
          "type": "integer",
          "minimum": 1
        },
        "group_daily_cap": {
          "type": "integer",
          "minimum": 1
        },
        "max_developing": {
          "type": "integer",
          "minimum": 1
        },
        "lease_hours": {
          "type": "integer",
          "minimum": 1
        },
        "stale_hours": {
          "type": "integer",
          "minimum": 1
        },
        "quote_max": {
          "type": "integer",
          "minimum": 1
        },
        "title_max": {
          "type": "integer",
          "minimum": 1
        },
        "detail_max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled",
        "auto_senders",
        "daily_auto_cap",
        "daily_cap_per_sender",
        "group_daily_cap",
        "max_developing",
        "lease_hours",
        "stale_hours",
        "quote_max",
        "title_max",
        "detail_max"
      ]
    },
    "stickers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collect": {
          "type": "boolean"
        },
        "send": {
          "type": "boolean"
        },
        "send_gif": {
          "type": "boolean"
        },
        "min_senders": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400000
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "read": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "send": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "tag",
            "read",
            "send"
          ]
        }
      },
      "required": [
        "enabled",
        "collect",
        "send_gif",
        "min_senders",
        "max_bytes",
        "max_rows",
        "caps"
      ]
    }
  },
  "required": [
    "model",
    "memory",
    "scout",
    "execution",
    "schedules",
    "repositories",
    "project_aliases",
    "bili",
    "rhythm",
    "stickers"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamAgent共享参数"
}
